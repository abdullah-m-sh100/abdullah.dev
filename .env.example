# Public site URL (used by metadata, canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form ---
# Inbox that receives contact submissions.
CONTACT_EMAIL_TO=
# Verified sender, e.g. "Portfolio <noreply@yourdomain.com>" — must be a
# domain verified with Resend. Never the visitor's own address. Until a
# domain is verified, Resend's shared sandbox sender also works — e.g.
# "Portfolio <onboarding@resend.dev>" — but it can only deliver to the
# Resend account's own login email, not arbitrary visitors' inboxes.
CONTACT_EMAIL_FROM=
# Resend API key. Server-only — never exposed to the browser.
RESEND_API_KEY=
