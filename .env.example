# Public site origin — used by canonical URLs, Open Graph tags, JSON-LD and the
# sitemap.
#
# LEAVE THIS UNSET unless you have a specific origin to force. `site-config.ts`
# already resolves the right value on its own: it uses the host's production
# domain when deployed (on Vercel, VERCEL_PROJECT_PRODUCTION_URL) and
# http://localhost:3000 when it is genuinely running locally.
#
# Setting it to localhost here is what previously leaked `http://localhost:3000`
# into the deployed site's canonical and Open Graph URLs — if this variable is
# defined in the hosting dashboard, it wins over the real domain. Set it only
# once a custom domain exists, to that domain, e.g.:
#
#   NEXT_PUBLIC_SITE_URL=https://abdullah.dev
#
# NEXT_PUBLIC_SITE_URL=

# --- Contact form ---
# Inbox that receives contact submissions.
CONTACT_EMAIL_TO=
# Verified sender, e.g. "Portfolio <noreply@yourdomain.com>" — must be a
# domain verified with Resend. Never the visitor's own address. Until a
# domain is verified, Resend's shared sandbox sender also works — e.g.
# "Portfolio <onboarding@resend.dev>" — but it can only deliver to the
# Resend account's own login email, not arbitrary visitors' inboxes.
CONTACT_EMAIL_FROM=
# Resend API key. Server-only — never exposed to the browser.
RESEND_API_KEY=
